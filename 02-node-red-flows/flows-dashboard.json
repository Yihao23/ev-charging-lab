    {
        "id": "lnk-in-telemetry",
        "type": "link in",
        "z": "flow-ocpp-dashboard",
        "name": "telemetry <-",
        "links": [
            "lnk-out-telemetry"
        ],
        "x": 115,
        "y": 140,
        "wires": [
            [
                "fn-split"
            ]
        ]
    },
    {
        "id": "fn-split",
        "type": "function",
        "z": "flow-ocpp-dashboard",
        "name": "split to widgets",
        "func": "// One telemetry record fans out to the dashboard widgets.\n// 一条遥测记录扇出到各个仪表盘控件。\n// Output order / 输出顺序: 1 status  2 current  3 power  4 transaction\nconst r = msg.payload;\n\nconst status  = { payload: r.status };\nconst charging = r.status === \"Charging\";\nconst current = (r.current_a !== null) ? { payload: r.current_a }\n    : (charging ? null : { payload: 0 });\nconst power = (r.power_w !== null) ? { payload: r.power_w, topic: \"Power (W)\" }\n    : (charging ? null : { payload: 0, topic: \"Power (W)\" });\nconst tx      = { payload: r.tx ? (\"tx \" + r.tx) : \"idle\" };\n\nreturn [status, current, power, tx];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 140,
        "wires": [
            [
                "ui-status"
            ],
            [
                "ui-current"
            ],
            [
                "ui-power"
            ],
            [
                "ui-tx"
            ]
        ]
    },
    {
        "id": "ui-status",
        "type": "ui_text",
        "z": "flow-ocpp-dashboard",
        "group": "ui-grp-state",
        "order": 1,
        "width": 6,
        "height": 1,
        "name": "connector status",
        "label": "Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 560,
        "y": 80,
        "wires": []
    },
